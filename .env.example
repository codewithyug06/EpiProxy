# Copy to .env and adjust as needed. All keys are optional; defaults shown.

# --- Redis connection ---
EPIPROXY_REDIS_URL=redis://localhost:6379
EPIPROXY_REDIS_CONNECT_TIMEOUT_MS=2000
EPIPROXY_REDIS_COMMAND_TIMEOUT_MS=2000

# --- Classifier ---
EPIPROXY_ML_MODEL_NAME=all-MiniLM-L6-v2
EPIPROXY_HEURISTIC_THRESHOLD=0.3
EPIPROXY_CLASSIFIER_TIMEOUT_SECONDS=10.0
EPIPROXY_CLASSIFIER_CACHE_SIZE=10000
EPIPROXY_CLASSIFIER_EXECUTOR_THREADS=4
# Score applied when async classification times out (security-conservative default: treat as risky).
EPIPROXY_TIMEOUT_FALLBACK_SCORE=1.0

# --- Circuit breaker / quarantine ---
EPIPROXY_CIRCUIT_BREAKER_THRESHOLD=1.0
EPIPROXY_QUARANTINE_TTL_SECONDS=3600

# --- Immunity registry ---
EPIPROXY_IMMUNITY_SIGNATURE_TTL_SECONDS=86400
EPIPROXY_IMMUNITY_SIGNATURE_CAP=100000

# --- Agent DAG (swarm topology) bounds ---
EPIPROXY_DAG_MAX_AGENTS=50000
EPIPROXY_DAG_TTL_SECONDS=86400

# --- R0 trust-tier weights (tier 0,1,2,3 -- comma-separated, 4 values) ---
EPIPROXY_TRUST_WEIGHTS=0.0,0.2,0.5,0.9

# --- Logging ---
EPIPROXY_LOG_LEVEL=INFO
